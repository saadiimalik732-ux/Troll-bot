{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "troll-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}